{
    "name": "COMP30024 Part B",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "extensions.verifySignature": false
            }
        }
    },
    "remoteUser": "dev"
}
